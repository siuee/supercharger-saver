# Neon Postgres (Vercel Marketplace) — source of truth for station prices.
DATABASE_URL=

# Optional Redis cache (legacy / transitional). Neon is preferred for reads.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Use a long random value (≥24 characters). Protects /api/sync and /api/ingest.
CRON_SECRET=

# Optional admin sync batch size (GitHub Actions scraper is the primary refresh path).
# SYNC_DAILY_LIMIT=1

# Optional scraper batch size for local runs (40–80 recommended).
# SCRAPER_BATCH_SIZE=60

# Optional for higher-traffic address search:
# PHOTON_URL=https://your-geocoder.example/api/
