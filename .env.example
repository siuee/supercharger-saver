# Required for shared cloud price cache (all concurrent users read this Redis).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CRON_SECRET=

# Required for Vercel daily cloud refresh of Tesla rates (Scrapfly recommended).
SCRAPFLY_KEY=

# Max Tesla detail refreshes per Vercel cron run (default 1 ≈ free Scrapfly monthly budget).
SYNC_DAILY_LIMIT=1

# Optional alternatives to Scrapfly for the cloud cron:
# SCRAPERAPI_KEY=
# TESLA_PROXY_URL=https://your-proxy.example/?url={url}

# Optional for higher-traffic address search:
# PHOTON_URL=https://your-geocoder.example/api/
